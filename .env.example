# Copy to .env (gitignored) and fill in. Never commit real values.

# --- MySpeedPuzzling database: READ-ONLY role ---
# Scripts query production over ssh + docker exec (no password); the values live only in .env.
MSP_DB_SSH=
MSP_DB_CONTAINER=
MSP_DB_ROLE=
MSP_DB_NAME=
# Optional: direct connection through an SSH tunnel (for TCP clients only)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=
DATABASE_URL_TUNNEL=

# --- Instagram API with Instagram Login (long-lived token, refresh before 60 days) ---
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
# Written by the refresh script: when the token was last refreshed (ISO date) and when it expires
IG_TOKEN_REFRESHED_AT=
IG_TOKEN_EXPIRES_AT=

# --- Cloudflare R2 (public image host for API publishing; objects deleted after publish) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
