# Copy to .env (gitignored) and fill in. Never commit real values.

# --- MySpeedPuzzling database: READ-ONLY role, reached through an SSH tunnel ---
# (connection/tunnel instructions live in the real .env, not here: this repo is public)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=
DATABASE_URL_TUNNEL=

# --- Instagram API with Instagram Login (long-lived token, refresh before 60 days) ---
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
