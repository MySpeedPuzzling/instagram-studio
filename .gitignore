# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*token*.json
secrets/

# --- generated / local-only ---
/var/
/drafts/
/output/
/renders/
/cache/
/models/
*.safetensors
*.gguf
*.ckpt
__pycache__/
.venv/
node_modules/
.DS_Store
.idea/

# local-only list of literals the pre-commit hook must block (hostnames etc.)
.secret-patterns

# --- pipeline working data (drafts mix in DB-derived data; never commit) ---
content/
*.sqlite
*.sqlite-*
logs/

# Claude Code local instructions (server/infra details; loaded automatically, never committed)
CLAUDE.local.md

# do-not-feature list holds player IDs (personal data); it lives in content/, this is a safety net
do-not-feature*

# Claude Code personal settings and third-party skills (restored from skills-lock.json, never vendored)
.claude/settings.local.json
.agents/
